# systemd unit — copy to /etc/systemd/system/english-study.service on the VPS,
# then: sudo systemctl daemon-reload && sudo systemctl enable --now english-study
#
# Adjust User/WorkingDirectory to match where you cloned the repo.

[Unit]
Description=English Study API
After=network.target

[Service]
Type=simple
User=eda
WorkingDirectory=/home/eda/english-study
EnvironmentFile=/home/eda/english-study/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node server/index.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
